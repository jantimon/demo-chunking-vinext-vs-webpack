+/// The projected static importees of `file` in the order `apply_inline_common_chunks_links`
+/// prints them: the file's own importees by `exec_order`, each record expanded in place into its
+/// importees, then any projected importee not reached that way (from carried records) last.
+fn printed_static_order(
+  file: ChunkIdx,
+  static_importees: &IndexVec<ChunkIdx, FxHashSet<ChunkIdx>>,
+  records: &FxIndexSet<ChunkIdx>,
+  projected: &FxHashMap<ChunkIdx, FxHashSet<ChunkIdx>>,
+  exec_order: &impl Fn(ChunkIdx) -> u32,
+) -> Vec<ChunkIdx> {
+  fn walk(
+    chunk: ChunkIdx,
+    static_importees: &IndexVec<ChunkIdx, FxHashSet<ChunkIdx>>,
+    records: &FxIndexSet<ChunkIdx>,
+    exec_order: &impl Fn(ChunkIdx) -> u32,
+    allowed: &FxHashSet<ChunkIdx>,
+    expanded: &mut FxHashSet<ChunkIdx>,
+    order: &mut FxIndexSet<ChunkIdx>,
+  ) {
+    let mut importees = static_importees[chunk].iter().copied().collect::<Vec<_>>();
+    importees.sort_unstable_by_key(|idx| (exec_order(*idx), idx.raw()));
+    for importee in importees {
+      if records.contains(&importee) {
+        if expanded.insert(importee) {
+          walk(importee, static_importees, records, exec_order, allowed, expanded, order);
+        }
+      } else if allowed.contains(&importee) {
+        order.insert(importee);
+      }
+    }
+  }
+  let allowed = &projected[&file];
+  let mut order = FxIndexSet::default();
+  let mut expanded = FxHashSet::default();
+  walk(file, static_importees, records, exec_order, allowed, &mut expanded, &mut order);
+  let mut rest = allowed.iter().copied().filter(|idx| !order.contains(idx)).collect::<Vec<_>>();
+  rest.sort_unstable_by_key(|idx| (exec_order(*idx), idx.raw()));
+  order.extend(rest);
+  order.into_iter().collect()
+}
